<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- The persistence unit of joi-server: the platform's entities (the platform ships no unit) and Joi's. A new entity
     is listed here and gets its table in a migration (hbm2ddl=validate). -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="PU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.github.enerccio.marginalia.domain.security.model.User</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.Resource</class>
        <class>com.github.enerccio.marginalia.domain.model.Setting</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.AI</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.Protocol</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.Tag</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.TagRelation</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.Usage</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.Job</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.JobCall</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.Gpu</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.GpuStep</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.GpuLock</class>
        <class>com.github.enerccio.marginalia.domain.security.model.Permission</class>
        <class>com.github.enerccio.marginalia.domain.security.model.ApiKey</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.OpenAICompatible</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.ExtensionAI</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.ChatCompletionProtocol</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.settings.AppSettings</class>
        <class>com.github.enerccio.marginalia.domain.model.impl.settings.NotificationSettings</class>
        <!-- joi -->
        <class>com.github.enerccio.joi.domain.model.impl.settings.JoiUserSetting</class>
        <class>com.github.enerccio.joi.domain.model.impl.Joi</class>
        <class>com.github.enerccio.joi.domain.model.impl.ChatMessage</class>
        <class>com.github.enerccio.joi.domain.model.impl.MessagePrompt</class>
        <class>com.github.enerccio.joi.domain.model.impl.Summary</class>
        <class>com.github.enerccio.joi.domain.model.impl.JoiTask</class>
        <class>com.github.enerccio.joi.domain.model.impl.JoiTaskMessage</class>
        <class>com.github.enerccio.joi.domain.model.impl.Memory</class>
        <class>com.github.enerccio.joi.domain.model.impl.QueuedEvent</class>
        <class>com.github.enerccio.joi.domain.model.impl.ToolMetadata</class>
        <class>com.github.enerccio.joi.domain.model.impl.AccessToken</class>
        <class>com.github.enerccio.joi.domain.model.impl.Model</class>
        <class>com.github.enerccio.joi.domain.model.impl.Body</class>
        <class>com.github.enerccio.joi.domain.model.impl.AnimationPack</class>
        <class>com.github.enerccio.joi.domain.model.impl.Animation</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="hibernate.dialect" value="com.github.enerccio.marginalia.SaneSQLiteDialect" />
            <property name="hibernate.hbm2ddl.auto" value="validate" />
            <!-- the default (grouped) asks the SQLite driver for the columns of all tables in one compound SELECT,
                 which SQLite refuses above 500 terms (columns of all tables together); the schema passed it -->
            <property name="hibernate.hbm2ddl.jdbc_metadata_extraction_strategy" value="individually" />
        </properties>
    </persistence-unit>
</persistence>
