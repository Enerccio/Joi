<?xml version="1.0" encoding="UTF-8"?>
<!--
  The platform's services that joi-server uses (the platform ships no Spring XML, see MARGINALIA.md). Taken from the
  platform's test wiring (Marginalia's platform/src/test/resources/META-INF/spring/test-application-config.xml), so it
  has no OSGi and no runtime instrumentation: no plugins (Claude and Gemini providers) yet. Joi's own services go
  below the platform's.
-->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- ===== platform ===== -->



    <bean id="userRepository" class="com.github.enerccio.marginalia.domain.security.repository.impl.JpaUserRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.security.AdminGuard" />

    <bean class="com.github.enerccio.marginalia.domain.security.service.impl.UserServiceImpl">
        <property name="repository" ref="userRepository" />
    </bean>

    <bean id="permissionRepository" class="com.github.enerccio.marginalia.domain.security.repository.impl.JpaPermissionRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.security.service.impl.PermissionServiceImpl">
        <property name="repository" ref="permissionRepository" />
    </bean>

    <bean id="apiKeyRepository" class="com.github.enerccio.marginalia.domain.security.repository.impl.JpaApiKeyRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.security.service.impl.ApiKeyServiceImpl">
        <property name="repository" ref="apiKeyRepository" />
    </bean>

    <bean class="com.github.enerccio.marginalia.api.ApiDispatcher" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.InferenceServicesImpl">
        <property name="inferenceProviders">
            <list>
                <value>com.github.enerccio.marginalia.domain.service.impl.inference.OpenAICompatibleInferenceService</value>
            </list>
        </property>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TemplateServiceImpl" />

    <bean id="settingRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaSettingRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.SettingServiceImpl">
        <property name="repository" ref="settingRepository" />
        <property name="userSettingClass" value="com.github.enerccio.joi.domain.model.impl.settings.JoiUserSetting" />
    </bean>

    <bean id="resourceRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaResourceRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ResourceServiceImpl">
        <property name="repository" ref="resourceRepository" />
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ResourceGarbageServiceImpl" />

    <bean id="aiRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaAIRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.AIServiceImpl">
        <property name="repository" ref="aiRepository" />
    </bean>

    <bean id="usageRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaUsageRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.UsageServiceImpl">
        <property name="repository" ref="usageRepository" />
    </bean>

    <bean id="jobRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaJobRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.JobServiceImpl">
        <property name="repository" ref="jobRepository" />
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.AILimitServiceImpl" />

    <bean id="protocolRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaProtocolRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ProtocolServiceImpl">
        <property name="repository" ref="protocolRepository" />
    </bean>

    <bean id="tagRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaTagRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TagServiceImpl">
        <property name="repository" ref="tagRepository" />
    </bean>

    <bean id="tagRelationRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaTagRelationRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TagRelationServiceImpl">
        <property name="repository" ref="tagRelationRepository" />
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.AIGateImpl" />

    <bean id="gpuRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaGpuRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean id="gpuLockRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaGpuLockRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean id="gpuStepRepository" class="com.github.enerccio.marginalia.domain.repository.impl.JpaGpuStepRepository">
        <property name="entityManager" ref="em"/>
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.GpuServiceImpl">
        <property name="gpuRepository" ref="gpuRepository" />
        <property name="lockRepository" ref="gpuLockRepository" />
        <property name="stepRepository" ref="gpuStepRepository" />
    </bean>

    <bean class="com.github.enerccio.marginalia.domain.service.impl.TokenizerServiceImpl" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ManualServiceImpl" init-method="load" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ToolServiceImpl" />

    <!-- the desktop notifications of the browser: what can notify (the sources, extensions add theirs) and what the user chose -->
    <bean class="com.github.enerccio.marginalia.domain.service.impl.NotificationServiceImpl" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.ExtensionServiceImpl" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.DatabaseBackupServiceImpl" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.UpdateServiceImpl" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.CommandServiceImpl" />

    <bean class="com.github.enerccio.marginalia.domain.service.impl.CleanupServiceImpl">
        <property name="entityManager" ref="em" />
    </bean>

    <!-- ===== joi ===== -->

    <!-- the speech of the user: TTS models, voice actors and their clips, in the user setting -->
    <bean class="com.github.enerccio.joi.domain.service.impl.TtsServiceImpl" />

    <!-- who the assistant is: her name, the prompts, personalities and moods (the user setting, else JoiDefaults) -->
    <bean class="com.github.enerccio.joi.domain.service.impl.PersonaServiceImpl" />

    <!-- the assistants; their template attributes are the first link of the chain of a setting -->
    <bean id="joiRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaJoiRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.JoiServiceImpl">
        <property name="repository" ref="joiRepository" />
    </bean>

    <!-- the conversation: an input (the user or an event) and the response with its reasoning -->
    <bean id="chatMessageRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaChatMessageRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.ChatMessageServiceImpl">
        <property name="repository" ref="chatMessageRepository" />
    </bean>

    <!-- the prompt sent for a message, stored apart from it -->
    <bean id="messagePromptRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaMessagePromptRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.MessagePromptServiceImpl">
        <property name="repository" ref="messagePromptRepository" />
    </bean>

    <!-- summaries of a time; a longer one covers the shorter ones -->
    <bean id="summaryRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaSummaryRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.SummaryServiceImpl">
        <property name="repository" ref="summaryRepository" />
    </bean>

    <!-- the tasks the assistant starts with a tool call, run after her reply -->
    <bean id="joiTaskRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaJoiTaskRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.JoiTaskServiceImpl">
        <property name="repository" ref="joiTaskRepository" />
    </bean>

    <!-- the transcripts of the tasks -->
    <bean id="joiTaskMessageRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaJoiTaskMessageRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.JoiTaskMessageServiceImpl">
        <property name="repository" ref="joiTaskMessageRepository" />
    </bean>

    <!-- the facts the assistant remembers -->
    <bean id="memoryRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaMemoryRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.MemoryServiceImpl">
        <property name="repository" ref="memoryRepository" />
    </bean>

    <!-- events that wait for a connected node -->
    <bean id="queuedEventRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaQueuedEventRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.QueuedEventServiceImpl">
        <property name="repository" ref="queuedEventRepository" />
    </bean>

    <!-- the 3D models of the user, what bodies are made of; their files are resources -->
    <bean id="modelRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaModelRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.ModelServiceImpl">
        <property name="repository" ref="modelRepository" />
    </bean>

    <!-- the .joim of a model: written when it changed, imported as a ready model -->
    <bean class="com.github.enerccio.joi.domain.service.impl.JoimServiceImpl" />

    <!-- the bodies of the assistants, made of the models -->
    <bean id="bodyRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaBodyRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.BodyServiceImpl">
        <property name="repository" ref="bodyRepository" />
    </bean>

    <!-- the animation packs of the user and their clips (VRMA files, resources of the user) -->
    <bean id="animationPackRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaAnimationPackRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.AnimationPackServiceImpl">
        <property name="repository" ref="animationPackRepository" />
    </bean>
    <bean id="animationRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaAnimationRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.AnimationServiceImpl">
        <property name="repository" ref="animationRepository" />
    </bean>
    <!-- the .joia of animations: exported with their clips, imported linking the clips the user has -->
    <bean class="com.github.enerccio.joi.domain.service.impl.JoiaServiceImpl" />
    <!-- converting an FBX or a BVH into clips with Blender (joi.blender, as for models); one Blender at a time -->
    <bean class="com.github.enerccio.joi.domain.service.impl.AnimationConversionServiceImpl">
        <property name="blender" value="${joi.blender:}" />
    </bean>

    <!-- how she looks in a model: a multimodal model describes it from its snapshots; one request at a time -->
    <bean class="com.github.enerccio.joi.domain.service.impl.AppearanceServiceImpl" />

    <!-- converting an FBX to VRM with Blender (joi.blender = JOI_BLENDER, empty: Blender.app on macOS, else blender
         on the PATH); one conversion at a time -->
    <bean class="com.github.enerccio.joi.domain.service.impl.ModelConversionServiceImpl">
        <property name="blender" value="${joi.blender:}" />
    </bean>

    <!-- the API (joi-protocol): its credentials, what the administrator offers, the OAuth device grant, chat -->
    <bean id="accessTokenRepository" class="com.github.enerccio.joi.domain.repository.impl.JpaAccessTokenRepository">
        <property name="entityManager" ref="em" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.AccessTokenServiceImpl">
        <property name="repository" ref="accessTokenRepository" />
    </bean>
    <bean class="com.github.enerccio.joi.domain.service.impl.ApiAccessServiceImpl" />
    <bean class="com.github.enerccio.joi.domain.service.impl.DeviceAuthorizationServiceImpl" />
    <!-- a chat turn: its steps, in the order of TurnStepType (see ChatService) -->
    <bean class="com.github.enerccio.joi.domain.chat.ChatServiceImpl">
        <property name="installedSteps">
            <list>
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.PrepareStep" />
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.PayloadStep" />
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.ToolsStep" />
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.InferenceStep" />
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.CallToolsStep" />
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.StoreStep" />
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.SpeechStep" />
                <bean class="com.github.enerccio.joi.domain.chat.turn.impl.CleanupStep" />
            </list>
        </property>
    </bean>
    <bean class="com.github.enerccio.joi.api.JoiApi" />
    <!-- the nodes connected over the WebSocket (api/NodeEndpoint): their tools, turns and calls -->
    <bean class="com.github.enerccio.joi.domain.service.impl.NodeServiceImpl" />
    <!-- the functions of her body: she changes a part of it herself -->
    <bean class="com.github.enerccio.joi.domain.chat.BodyTools" />

</beans>
