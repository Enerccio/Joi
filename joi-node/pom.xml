<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The reference node (see DESIGN.md → Node): the server client (login, OAuth device grant, the assistants, her
       body's files cached by hash), the node WebSocket, what her body plays in each state, and a terminal client.
       The JavaFX app (package fx) builds only with -Pfx, which brings OpenJFX. -->
  <parent>
    <groupId>io.github.enerccio</groupId>
    <artifactId>joi-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>joi-node</artifactId>
  <packaging>jar</packaging>
  <name>joi-node</name>

  <properties>
    <fx.excludes>com/github/enerccio/joi/node/fx/**</fx.excludes>
    <jcef.excludes>org/cef/**</jcef.excludes>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.enerccio</groupId>
      <artifactId>joi-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- the renderer page (src/main/renderer, npm run build; built by the fx profile) -->
      <resource>
        <directory>src/main/renderer/dist</directory>
        <targetPath>joi-renderer</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>${java.version}</release>
          <encoding>UTF-8</encoding>
          <parameters>true</parameters>
          <excludes>
            <exclude>${fx.excludes}</exclude>
            <exclude>${jcef.excludes}</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The JavaFX app with Chromium: mvn -o -Pfx compile exec:exec@run -pl joi-node (OpenJFX 25 and JCEF are in ~/.m2) -->
    <profile>
      <id>fx</id>
      <properties>
        <fx.excludes>none</fx.excludes>
        <jcef.excludes>none</jcef.excludes>
        <node.args></node.args>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-controls</artifactId>
          <version>${javafx.version}</version>
        </dependency>
        <dependency>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-media</artifactId>
          <version>${javafx.version}</version>
        </dependency>
        <!-- the renderer page in the app: Chromium (JCEF), with its natives for this machine (jcef.platform, set by the
             profiles of the root POM) from the repository instead of a download at run time -->
        <dependency>
          <groupId>me.friwi</groupId>
          <artifactId>jcefmaven</artifactId>
          <version>${jcef.version}</version>
        </dependency>
        <dependency>
          <groupId>me.friwi</groupId>
          <artifactId>jcef-natives-${jcef.platform}</artifactId>
          <version>${jcef.natives.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <!-- the renderer page: npm from its cache (offline; the property npm.mode allows the network), then Vite, before the resources are copied -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <!-- runs the app: mvn -o -Pfx compile exec:exec@run -pl joi-node (-Dnode.args=preview for RendererPreviewApp).
                 Not javafx:run: that plugin leaves JCEF's natives, JOGL and gluegen off the class path -->
              <execution>
                <id>run</id>
                <configuration>
                  <executable>java</executable>
                  <workingDirectory>${project.basedir}</workingDirectory>
                  <arguments>
                    <!-- JavaFX and JCEF load their native libraries: allowed, without the warning -->
                    <argument>--enable-native-access=ALL-UNNAMED</argument>
                    <!-- JCEF on macOS reaches into AWT's internals -->
                    <argument>--add-opens=java.desktop/sun.awt=ALL-UNNAMED</argument>
                    <argument>--add-opens=java.desktop/sun.lwawt=ALL-UNNAMED</argument>
                    <argument>--add-opens=java.desktop/sun.lwawt.macosx=ALL-UNNAMED</argument>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>com.github.enerccio.joi.node.fx.Launcher</argument>
                    <argument>${node.args}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>renderer-install</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${npm.executable}</executable>
                  <workingDirectory>${project.basedir}/src/main/renderer</workingDirectory>
                  <arguments>
                    <argument>install</argument>
                    <argument>${npm.mode}</argument>
                    <argument>--no-audit</argument>
                    <argument>--no-fund</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>renderer-build</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${npm.executable}</executable>
                  <workingDirectory>${project.basedir}/src/main/renderer</workingDirectory>
                  <arguments>
                    <argument>run</argument>
                    <argument>build</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>

        </plugins>
      </build>
    </profile>
  </profiles>
</project>
