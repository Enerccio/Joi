{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Enerccio/joi/protocol/v1/TaskList.schema.json",
  "title": "TaskList",
  "description": "GET /api/v1/jois/{id}/tasks (since 1.6): her tasks, the newest first.",
  "type": "object",
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "TaskInfo.schema.json"
      }
    }
  },
  "required": [
    "tasks"
  ]
}
