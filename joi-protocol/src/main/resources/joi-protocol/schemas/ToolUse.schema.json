{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Enerccio/joi/protocol/v1/ToolUse.schema.json",
  "title": "ToolUse",
  "description": "tool: she used a tool in the turn (of a node or of the server), after it answered.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The tool as she called it (desk__read_file)."
    },
    "arguments": {
      "type": "string",
      "description": "The arguments, JSON."
    },
    "result": {
      "type": [
        "string",
        "null"
      ],
      "description": "What it answered."
    },
    "ok": {
      "type": "boolean",
      "description": "False when it failed or was denied."
    }
  },
  "required": [
    "name",
    "arguments",
    "ok"
  ]
}
