{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Enerccio/joi/protocol/v1/BodyModel.schema.json",
  "title": "BodyModel",
  "description": "A model of a body.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "joim": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "Download.schema.json"
        }
      ],
      "description": "Its .joim, null when none was written yet."
    }
  },
  "required": [
    "id"
  ]
}
