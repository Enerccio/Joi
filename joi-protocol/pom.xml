<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The public API of Joi: the JSON Schemas and the OpenAPI description (src/main/resources/joi-protocol, the source
       of truth) and the Java records that follow them. Plain Java and Gson only, so any node can use it. -->
  <parent>
    <groupId>io.github.enerccio</groupId>
    <artifactId>joi-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>joi-protocol</artifactId>
  <packaging>jar</packaging>
  <name>joi-protocol</name>

  <dependencies>
    <!-- @SerializedName for the OAuth fields (snake_case, as RFC 6749 / 8628 name them) -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.10.1</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
      <version>1.5.6</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.27.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>${java.version}</release>
          <encoding>UTF-8</encoding>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.4</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <!-- The iOS app's protocol: the Swift package written from the schemas, and its tests (see DESIGN.md, the iOS app).
         mvn -Pswift test -pl joi-protocol          generates, runs the Java tests, then `swift test`
         mvn -Pswift process-test-classes -pl joi-protocol    generates only
         Not in the normal build: that must not write into the source tree. SwiftGeneratorTest fails when the files in Git are stale. -->
    <profile>
      <id>swift</id>
      <properties>
        <swift.package>${project.basedir}/../joi-ios/Packages/JoiProtocol</swift.package>
        <swift.test.flags></swift.test.flags>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>swift-generate</id>
                <phase>process-test-classes</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>com.github.enerccio.joi.protocol.swift.SwiftGenerator</mainClass>
                  <classpathScope>test</classpathScope>
                  <arguments>
                    <argument>${swift.package}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>swift-test</id>
                <phase>test</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>swift</executable>
                  <!-- swift.test.flags: more for swift, e.g. the Testing framework's folder with only the Command Line Tools -->
                  <commandlineArgs>test --package-path ${swift.package} ${swift.test.flags}</commandlineArgs>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
