# build output
target/
build/
node_modules/
/.idea/
*.iml

# Vaadin: generated by the frontend build of joi-server
/joi-server/src/main/frontend/generated/
/joi-server/src/main/frontend/index.html
/joi-server/src/main/bundles/
/joi-server/src/main/resources/META-INF/VAADIN/config/flow-build-info.json
/joi-server/package.json
/joi-server/package-lock.json
/joi-server/tsconfig.json
/joi-server/types.d.ts
/joi-server/vite.config.ts
/joi-server/vite.generated.ts
/.claude/launch.json

# JVM crash logs
hs_err_pid*.log

# screenshot environment (screenshots/SCREENSHOTS.md): data, run state, tooling, step backups, work-in-progress images
/screenshots/.data/
/screenshots/.run/
/screenshots/node_modules/
/screenshots/out/
/screenshots/steps/*.tar.gz
/screenshots/final/
/screenshots/assets/*.jpg

# generated manual site (retype build)
/docs/
/build/i18n/
retype.manifest

# the commit the running container was built from (rebuild.sh, rebuild.bat)
/.rebuild-deployed

# web-ext: the state of an AMO upload
joi-browser/src/.amo-upload-uuid
joi-browser/src/.web-extension-id
