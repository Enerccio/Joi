{
  "name": "joi-browser",
  "version": "0.1.0",
  "private": true,
  "description": "The browser companion of Joi: a Firefox extension that talks to the Joi node through native messaging",
  "scripts": {
    "lint": "web-ext lint --source-dir src",
    "build": "web-ext build --source-dir src --artifacts-dir target --overwrite-dest",
    "run": "web-ext run --source-dir src",
    "sign": "web-ext sign --source-dir src --artifacts-dir target --channel unlisted"
  },
  "devDependencies": {
    "web-ext": "8.3.0"
  }
}
