<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    The iOS app of Joi, built by Maven the way the desktop app is: the Swift code is not Java, so this module only calls the tools. Part of
    the build only with the root POM's profile `ios`, and with `swift` for the protocol's Swift package (written by joi-protocol):

      mvn -Pswift,ios verify -pl joi-ios -am

    needs Xcode (macOS only) and XcodeGen (`brew install xcodegen`). What it does, in the order of the lifecycle:
      joi-protocol (-Pswift)   the Swift protocol package from the schemas, its tests (`swift test`)
      process-resources        xcodegen: Joi.xcodeproj from project.yml
      test                     `swift test` of the packages JoiClient and JoiApp (on the Mac)
      compile                  xcodebuild: the app for the Simulator, signed ad hoc (the Keychain needs the entitlements a signature carries) (target/DerivedData)
      package                  xcodebuild archive for a device, only with -Dios.skipArchive=false -Dios.team=<team id> (signing)
    The .ipa (-exportArchive) and the upload to TestFlight are not here yet. The version is ios.marketingVersion (x.y.z, CI sets it
    from the tag) and ios.buildNumber, not the POM's (a -SNAPSHOT is not a version of an app).
  -->
  <parent>
    <groupId>io.github.enerccio</groupId>
    <artifactId>joi-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>joi-ios</artifactId>
  <packaging>pom</packaging>
  <name>joi-ios</name>

  <properties>
    <ios.marketingVersion>0.1.0</ios.marketingVersion>
    <ios.buildNumber>1</ios.buildNumber>
    <ios.team></ios.team>
    <ios.skipArchive>true</ios.skipArchive>
    <ios.derivedData>${project.build.directory}/DerivedData</ios.derivedData>
  </properties>

  <!-- not used by the Swift code; it puts this module after joi-protocol in the reactor, which writes the Swift package of the protocol -->
  <dependencies>
    <dependency>
      <groupId>io.github.enerccio</groupId>
      <artifactId>joi-protocol</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <executable>xcodebuild</executable>
          <workingDirectory>${project.basedir}</workingDirectory>
        </configuration>
        <executions>
          <!-- her body in the app is the node's renderer page (three.js and three-vrm in a web view): built with npm
               (its cache first, the network for what is missing: the property npm.mode), and copied into the app's folder Renderer, which the Xcode project holds as resources -->
          <execution>
            <id>renderer-install</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${npm.executable}</executable>
              <workingDirectory>${project.basedir}/../joi-node/src/main/renderer</workingDirectory>
              <arguments>
                <argument>install</argument>
                <argument>${npm.mode}</argument>
                <argument>--no-audit</argument>
                <argument>--no-fund</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>renderer-build</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>${npm.executable}</executable>
              <workingDirectory>${project.basedir}/../joi-node/src/main/renderer</workingDirectory>
              <arguments>
                <argument>run</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>renderer-copy</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>rsync</executable>
              <arguments>
                <argument>-a</argument>
                <argument>--delete</argument>
                <argument>../joi-node/src/main/renderer/dist/</argument>
                <argument>App/Renderer/</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>xcodegen</id>
            <phase>process-resources</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>xcodegen</executable>
              <arguments>
                <argument>generate</argument>
                <argument>--spec</argument>
                <argument>project.yml</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>swift-test-client</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>swift</executable>
              <arguments>
                <argument>test</argument>
                <argument>--package-path</argument>
                <argument>Packages/JoiClient</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>swift-test-app</id>
            <phase>test</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <executable>swift</executable>
              <arguments>
                <argument>test</argument>
                <argument>--package-path</argument>
                <argument>Packages/JoiApp</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>xcodebuild-simulator</id>
            <phase>compile</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <arguments>
                <argument>-project</argument>
                <argument>Joi.xcodeproj</argument>
                <argument>-scheme</argument>
                <argument>Joi</argument>
                <argument>-destination</argument>
                <argument>generic/platform=iOS Simulator</argument>
                <argument>-derivedDataPath</argument>
                <argument>${ios.derivedData}</argument>
                <argument>CODE_SIGN_IDENTITY=-</argument>
                <argument>DEVELOPMENT_TEAM=</argument>
                <argument>MARKETING_VERSION=${ios.marketingVersion}</argument>
                <argument>CURRENT_PROJECT_VERSION=${ios.buildNumber}</argument>
                <argument>build</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>xcodebuild-archive</id>
            <phase>package</phase>
            <goals>
              <goal>exec</goal>
            </goals>
            <configuration>
              <skip>${ios.skipArchive}</skip>
              <arguments>
                <argument>-project</argument>
                <argument>Joi.xcodeproj</argument>
                <argument>-scheme</argument>
                <argument>Joi</argument>
                <argument>-destination</argument>
                <argument>generic/platform=iOS</argument>
                <argument>-archivePath</argument>
                <argument>${project.build.directory}/Joi.xcarchive</argument>
                <argument>-allowProvisioningUpdates</argument>
                <argument>DEVELOPMENT_TEAM=${ios.team}</argument>
                <argument>MARKETING_VERSION=${ios.marketingVersion}</argument>
                <argument>CURRENT_PROJECT_VERSION=${ios.buildNumber}</argument>
                <argument>archive</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
